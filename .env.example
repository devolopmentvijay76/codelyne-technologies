# App runtime
NODE_ENV=development
PORT=5000

# Database
DATABASE_URL=postgresql://postgres:postgres@db:5432/codelyne

# Session/auth
SESSION_SECRET=replace-with-a-long-random-secret

# Public site URLs (SEO/canonical tags/sitemap)
SITE_URL=http://localhost:5000
VITE_SITE_URL=http://localhost:5000

# One-time setup endpoint guard
SETUP_KEY=replace-with-a-private-setup-key

# Replit Object Storage integration (required for upload/media features)
# Format example: /bucket-name/public
PUBLIC_OBJECT_SEARCH_PATHS=
# Format example: /bucket-name/private
PRIVATE_OBJECT_DIR=
# Local upload fallback directory (used when Replit object storage is unavailable)
LOCAL_UPLOADS_DIR=public/uploads

# Dev sync (optional): seed local DB from the live Replit deployment
# Set to 1 to seed on container startup.
SEED_FROM_LIVE=1
LIVE_BASE_URL=https://codelyne-website-v-2.replit.app
# Set to 1 to truncate and fully reseed every time (overwrites local edits).
FORCE_SEED_FROM_LIVE=0
