# App runtime
NODE_ENV=development
PORT=5000

# Database
DATABASE_URL=postgresql://postgres:postgres@db:5432/codelyne

# Session/auth
SESSION_SECRET=replace-with-a-long-random-secret

# Public site URLs (SEO/canonical tags/sitemap)
SITE_URL=http://localhost:5000
VITE_SITE_URL=http://localhost:5000

# One-time setup endpoint guard
SETUP_KEY=replace-with-a-private-setup-key

# Object storage (hosted presigned-URL flow; optional paths for public/private buckets)
# Format example: /bucket-name/public
PUBLIC_OBJECT_SEARCH_PATHS=
# Format example: /bucket-name/private
PRIVATE_OBJECT_DIR=
# Local upload fallback when the hosted storage sidecar is unavailable
LOCAL_UPLOADS_DIR=public/uploads

# Optional: Vite build — absolute URLs for og/twitter images (overrides auto-detected hosting env)
# DEPLOYMENT_INTERNAL_DOMAIN=your-production-host.example
# DEPLOYMENT_PREVIEW_DOMAIN=your-staging-host.example

# Dev sync (optional): seed local DB from a live deployment’s public API
# Set to 1 to seed on container startup.
SEED_FROM_LIVE=1
# Optional. If unset, dev seeding uses the same public API host as the original deployment.
# LIVE_BASE_URL=
# Set to 1 to truncate and fully reseed every time (overwrites local edits).
FORCE_SEED_FROM_LIVE=0
